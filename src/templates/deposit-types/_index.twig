{% extends "_layouts/cp" %}

{% set title = "Container Deposits"|t('container-deposits') %}
{% set fullPageForm = false %}

{% set crumbs = [
    { label: "Container Deposits"|t('container-deposits'), url: url('container-deposits') }
] %}

{% block actionButton %}
    <a id="container-deposits-new-btn" href="{{ url('container-deposits/new') }}" class="btn submit add icon">
        {{ "New Deposit Type"|t('container-deposits') }}
    </a>
{% endblock %}

{% block content %}
    {% if depositTypes|length %}
        <div class="tableview">
            <table class="data fullwidth collapsible" id="deposittypes">
                <thead>
                    <tr>
                        <th scope="col">{{ "Name"|t('app') }}</th>
                        <th scope="col">{{ "Handle"|t('app') }}</th>
                        <th scope="col">{{ "Amount"|t('container-deposits') }}</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for type in depositTypes %}
                        <tr data-id="{{ type.id }}" data-name="{{ type.name|e }}">
                            <td>
                                <a href="{{ url('container-deposits/' ~ type.id) }}" class="go">{{ type.name }}</a>
                            </td>
                            <td class="code">{{ type.handle }}</td>
                            <td>{{ type.amount|currency(craft.commerce.paymentCurrencies.primaryPaymentCurrency.iso) }}</td>
                            <td class="thin">
                                <button type="button" class="delete icon"
                                   title="{{ 'Delete'|t('app') }}"
                                   aria-label="{{ 'Delete {name}'|t('container-deposits', { name: type.name }) }}"
                                   data-confirm="{{ 'Are you sure you want to delete "{name}"?'|t('container-deposits', { name: type.name }) }}"
                                   data-action="container-deposits/deposit-types/delete"
                                   data-id="{{ type.id }}"></button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>{{ "No deposit types yet."|t('container-deposits') }}</p>
    {% endif %}
{% endblock %}

{% js %}
    (function() {
        var DELETE_SELECTOR = '[data-action="container-deposits/deposit-types/delete"]';
        var newBtn = document.getElementById('container-deposits-new-btn');

        document.querySelectorAll(DELETE_SELECTOR).forEach(function(button) {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                if (!confirm(button.dataset.confirm)) return;

                var row = button.closest('tr');
                var nextRow = row ? row.nextElementSibling : null;
                var prevRow = row ? row.previousElementSibling : null;

                Craft.sendActionRequest('POST', 'container-deposits/deposit-types/delete', {
                    data: { id: button.dataset.id }
                }).then(function(response) {
                    var data = response.data;
                    if (data.success) {
                        if (row) row.remove();

                        // Keep keyboard focus in the table rather than
                        // dropping it on the body: the next row's delete
                        // button, else the previous row's, else the page's
                        // own "New" action.
                        var focusTarget = (nextRow && nextRow.querySelector(DELETE_SELECTOR))
                            || (prevRow && prevRow.querySelector(DELETE_SELECTOR))
                            || newBtn;
                        if (focusTarget) focusTarget.focus();

                        Craft.cp.displayNotice(Craft.t('container-deposits', 'Deposit type deleted.'));
                    } else {
                        Craft.cp.displayError(data.error || Craft.t('app', 'An unknown error occurred.'));
                    }
                });
            });
        });
    }());
{% endjs %}
