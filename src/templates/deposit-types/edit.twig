{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}
{% set title = isNew ? "New Deposit Type"|t('container-deposits') : depositType.name %}

{% set crumbs = [
    { label: "Container Deposits"|t('container-deposits'), url: url('container-deposits') },
    { label: isNew ? "New Deposit Type"|t('container-deposits') : depositType.name, url: '' }
] %}

{% set fullPageForm = true %}
{% set saveShortcutRedirect = 'container-deposits/{id}' %}

{% block actionButton %}
    <div class="btngroup submit">
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    </div>
{% endblock %}

{% block content %}
    <input type="hidden" name="action" value="container-deposits/deposit-types/save">
    {% if not isNew %}
        <input type="hidden" name="id" value="{{ depositType.id }}">
    {% endif %}
    {{ redirectInput('container-deposits') }}
    {{ csrfInput() }}

    <div id="fields">
        {{ forms.textField({
            first: true,
            label: 'Name'|t('app'),
            instructions: 'The label shown on the deposit line item in cart (e.g. "Can Deposit", "Container Deposits").'|t('container-deposits'),
            id: 'name',
            name: 'name',
            value: depositType.name,
            errors: depositType.getErrors('name'),
            autofocus: true,
            required: true
        }) }}

        {{ forms.textField({
            label: 'Handle'|t('app'),
            instructions: 'A unique identifier used internally (e.g. "canDeposit", "containerDeposit").'|t('container-deposits'),
            id: 'handle',
            name: 'handle',
            class: 'code',
            value: depositType.handle,
            errors: depositType.getErrors('handle'),
            required: true
        }) }}

        {{ forms.textField({
            label: 'Amount'|t('container-deposits'),
            instructions: 'The deposit amount in the store currency (e.g. 0.15 for €0.15).'|t('container-deposits'),
            id: 'amount',
            name: 'amount',
            type: 'number',
            step: '0.01',
            min: '0',
            value: depositType.amount,
            errors: depositType.getErrors('amount'),
            required: true
        }) }}
    </div>
{% endblock %}

{% js %}
    new Craft.HandleGenerator('#name', '#handle');
{% endjs %}
