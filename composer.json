{
  "name": "johnhenry/craft-container-deposits",
  "description": "Container deposits for Craft Commerce, each on its own cart line and kept out of VAT and discounts. Set up for Ireland's Re-turn scheme.",
  "type": "craft-plugin",
  "version": "1.1.0",
  "keywords": [
    "craft-commerce",
    "container deposits",
    "deposit return scheme",
    "drs",
    "re-turn",
    "bottle deposit",
    "can deposit",
    "drinks",
    "multipacks",
    "vat exempt",
    "receipts",
    "ireland"
  ],
  "license": "proprietary",
  "authors": [
    {
      "name": "John Henry",
      "homepage": "https://johnhenry.ie"
    }
  ],
  "homepage": "https://johnhenry.ie/plugins/container-deposits/",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "craftcms/cms": "^5.0",
    "craftcms/commerce": "^5.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.2"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "johnhenry\\containerdeposits\\": "src/"
    }
  },
  "scripts": {
    "phpstan": "phpstan --ansi --memory-limit=1G",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --fix --ansi"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "yiisoft/yii2-composer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "support": {
    "docs": "https://johnhenry.ie/plugins/container-deposits/",
    "source": "https://github.com/john-henry/craft-container-deposits",
    "issues": "https://github.com/john-henry/craft-container-deposits/issues"
  },
  "extra": {
    "name": "Container Deposits",
    "handle": "container-deposits",
    "developer": "John Henry",
    "developerUrl": "https://johnhenry.ie",
    "documentationUrl": "https://johnhenry.ie/plugins/container-deposits/",
    "changelogUrl": "https://github.com/john-henry/craft-container-deposits/blob/craft-5/CHANGELOG.md",
    "class": "johnhenry\\containerdeposits\\ContainerDeposits"
  }
}
